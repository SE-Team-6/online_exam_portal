PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/online_exam_portal
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
# Production TLS: configure both paths to a PEM private key and certificate.
TLS_KEY_PATH=
TLS_CERT_PATH=
# Set true only when TLS terminates at a trusted reverse proxy.
TLS_TERMINATED_BY_PROXY=false
TRUST_PROXY_HOPS=0
# Defaults to true in production. Requests without HTTPS are rejected with 426.
REQUIRE_HTTPS=
FRONTEND_ORIGIN=http://localhost:5173
